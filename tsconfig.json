{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "baseUrl": ".",
    "paths": {
      "src/*": [
        "./src/*"
      ],
      "@ts-testing/*": [
        "./backend/unit_testing/app/functionality_test_suites/ts_testing/*"
      ]
    }
  },
}
