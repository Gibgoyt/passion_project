---
export const prerender = true;
import Layout from 'src/layouts/Layout.astro';
import HeroSection from 'src/components/HeroSection.astro';
---

<Layout title="About Us - Pritchard Specialised Solutions">
	<main>
		<!-- Page Header -->
		<HeroSection>
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
				<nav class="mb-8" aria-label="Breadcrumb">
					<div class="flex items-center space-x-2 text-sm">
						<a href="/" class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 transition-colors">
							Home
						</a>
						<span class="text-gray-400 dark:text-gray-500">/</span>
						<span class="text-gray-600 dark:text-gray-300">About</span>
					</div>
				</nav>

				<div class="text-center">
					<h1 class="text-4xl lg:text-6xl font-bold mb-6 text-gray-900 dark:text-gray-100">
						About Us
					</h1>
					<p class="text-xl lg:text-2xl text-gray-600 dark:text-gray-300 mb-8 max-w-3xl mx-auto">
						We are a team of passionate IT professionals dedicated to helping businesses succeed.
					</p>
					<div class="flex flex-col sm:flex-row gap-4 justify-center">
						<a href="/contact" class="px-8 py-4 bg-blue-600 text-white text-lg rounded-lg hover:bg-blue-700 transition-colors shadow-lg hover:shadow-xl">
							Work With Us
						</a>
						<a href="/services" class="px-8 py-4 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 text-lg rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors shadow-lg hover:shadow-xl border border-gray-200 dark:border-gray-700">
							Our Services
						</a>
					</div>
				</div>
			</div>
		</HeroSection>

		<!-- Our Story Section -->
		<section class="py-16 lg:py-24">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
					<div>
						<h2 class="text-3xl lg:text-4xl font-bold mb-6 text-gray-900 dark:text-gray-100">
							Our Story
						</h2>
						<div class="space-y-6 text-gray-600 dark:text-gray-300">
							<p class="text-lg">
								Pritchard Specialised Solutions was founded in 2025 with a mission to provide small and medium-sized businesses with the same level of IT expertise and support that large enterprises enjoy. Our founders, Alexander Walker and Joshua Sack, saw a need for a customer-centric IT services company that could provide customized solutions to meet the unique needs of each client.
							</p>
							<p class="text-lg">
								Pritchard Specialised Solutions is committed to becoming a leading provider of IT services in the region, with a team of certified professionals who are passionate about helping businesses succeed. We are dedicated to building lasting relationships with our clients and providing them with the highest quality service and support.
							</p>
						</div>
					</div>

					<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8">
						<div class="relative">
							<div class="flex items-center space-x-4">
								<div class="flex-shrink-0">
									<div class="w-12 h-12 bg-blue-100 dark:bg-blue-900 rounded-full flex items-center justify-center">
										<i class="fas fa-calendar-alt text-blue-600 dark:text-blue-400"></i>
									</div>
								</div>
								<div>
									<div class="text-2xl font-bold text-blue-600 dark:text-blue-400 mb-1">2025</div>
									<h4 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2">Company Founded</h4>
									<p class="text-gray-600 dark:text-gray-300">
										Alexander Walker and Joshua Sack establish Pritchard Specialised Solutions
									</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Meet the Team Section -->
		<section class="py-16 lg:py-24 bg-gray-50 dark:bg-gray-900">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-12">
					<h2 class="text-3xl lg:text-4xl font-bold mb-4 text-gray-900 dark:text-gray-100">
						Meet the Team
					</h2>
					<p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
						Our team of experts is here to help you with all your IT needs.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
					<!-- Alexander Walker -->
					<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8 text-center hover:shadow-xl transition-shadow">
						<div class="mb-6">
							<picture>
								<source srcset="./assets/Alex.webp" type="image/webp" />
								<img src="./assets/Alex.webp" alt="Alexander Walker" class="w-32 h-32 rounded-full object-cover mx-auto shadow-lg" />
							</picture>
						</div>
						<h3 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-2">Alexander Walker</h3>
						<p class="text-blue-600 dark:text-blue-400 font-medium mb-4">Co-Founder & CEO</p>
						<p class="text-gray-600 dark:text-gray-300">
							Leading our strategic vision and client relationships with extensive IT industry experience.
						</p>
					</div>

					<!-- Joshua Sack -->
					<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8 text-center hover:shadow-xl transition-shadow">
						<div class="mb-6">
							<picture>
								<source srcset="./assets/josh.webp" type="image/webp" />
								<img src="./assets/josh.webp" alt="Joshua Sack" class="w-32 h-32 rounded-full object-cover mx-auto shadow-lg" />
							</picture>
						</div>
						<h3 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-2">Joshua Sack</h3>
						<p class="text-purple-600 dark:text-purple-400 font-medium mb-4">Co-Founder & CTO</p>
						<p class="text-gray-600 dark:text-gray-300">
							Driving technical innovation and ensuring our solutions meet the highest standards of excellence.
						</p>
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>