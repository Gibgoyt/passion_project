---
import Layout from '../../../../layouts/Layout.astro';
import { FormValidator, required, minLength, pattern, isString } from '../../../../../libraries/runtime_validation/index';

let errors: Record<string, string> = {};
let values = { name: '', surname: '' };
let successMessage = '';
let serverError = '';

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    values.name = formData.get("name")?.toString() || "";
    values.surname = formData.get("surname")?.toString() || "";

    const validator = new FormValidator({
      name: [
          required("Name is required"), 
          isString(),
          minLength(2, "Name must be at least 2 characters"),
          pattern(/^[a-zA-Z\s-]+$/, "Name can only contain letters, spaces, and hyphens")
      ],
      surname: [
          required("Surname is required"),
          isString(),
          minLength(2, "Surname must be at least 2 characters"),
          pattern(/^[a-zA-Z\s-]+$/, "Surname can only contain letters, spaces, and hyphens")
      ]
    });

    const result = validator.validate(values);

    if (result.success) {
      // Mock API call or just success
      // In a real app, we would fetch(API_URL, { method: 'POST', body: JSON.stringify(result.data) ... })
      successMessage = `Successfully validated user: ${result.data.name} ${result.data.surname}`;
      
      // Clear values on success if desired, but keeping them to show what was submitted is often nice.
      // values = { name: '', surname: '' }; 
    } else {
      result.errors.forEach(err => {
        errors[err.field] = err.message;
      });
    }
  } catch (e: any) {
    serverError = "An error occurred processing your request: " + e.message;
  }
}
---

<Layout title="User Creation Runtime Validation Test">
  <main class="container mx-auto p-4 max-w-lg mt-10">
    <div class="bg-white dark:bg-gray-800 shadow-md rounded-lg p-6 border border-gray-200 dark:border-gray-700">
      <h1 class="text-2xl font-bold mb-6 text-gray-900 dark:text-gray-100">Create User (Validation Test)</h1>
      
      {successMessage && (
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4" role="alert">
          <strong class="font-bold">Success!</strong>
          <span class="block sm:inline">{successMessage}</span>
        </div>
      )}

      {serverError && (
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4" role="alert">
          <strong class="font-bold">Error!</strong>
          <span class="block sm:inline">{serverError}</span>
        </div>
      )}

      <form method="POST" class="space-y-6">
        <!-- Name Field -->
        <div>
          <label for="name" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Human Name</label>
          <div class="mt-1">
            <input 
              type="text" 
              id="name" 
              name="name" 
              value={values.name}
              placeholder="e.g. John"
              class={`shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border rounded-md p-2.5 bg-gray-50 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white ${errors.name ? 'border-red-500 ring-red-500' : 'border-gray-300'}`}
            />
          </div>
          {errors.name && <p class="mt-2 text-sm text-red-600 dark:text-red-400">{errors.name}</p>}
        </div>

        <!-- Surname Field -->
        <div>
          <label for="surname" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Surname</label>
          <div class="mt-1">
            <input 
              type="text" 
              id="surname" 
              name="surname" 
              value={values.surname}
              placeholder="e.g. Doe"
              class={`shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border rounded-md p-2.5 bg-gray-50 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white ${errors.surname ? 'border-red-500 ring-red-500' : 'border-gray-300'}`}
            />
          </div>
          {errors.surname && <p class="mt-2 text-sm text-red-600 dark:text-red-400">{errors.surname}</p>}
        </div>

        <!-- Submit Button -->
        <div>
          <button type="submit" class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors">
            Validate & Create
          </button>
        </div>
      </form>

      <div class="mt-6 text-sm text-gray-500 dark:text-gray-400">
        <p>This form uses a custom runtime validation library located in <code>libraries/runtime_validation/</code>.</p>
      </div>
    </div>
  </main>
</Layout>
