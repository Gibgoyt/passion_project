---
export const prerender = true;
import Layout from 'src/layouts/Layout.astro';
import HeroSection from 'src/components/HeroSection.astro';
---

<Layout title="Pritchard Specialised Solutions - Expert IT Services & Cybersecurity">
	<!-- Structured Data -->
	<script type="application/ld+json" is:inline>
		{
			"@context": "https://schema.org",
			"@type": "Organization",
			"name": "Pritchard Specialised Solutions",
			"description": "Professional IT services, cybersecurity, automation, and cloud solutions for businesses",
			"url": "./",
			"logo": "./assets/logo.webp",
			"foundingDate": "2025",
			"address": {
				"@type": "PostalAddress",
				"addressLocality": "Johannesburg",
				"addressCountry": "South Africa"
			},
			"contactPoint": {
				"@type": "ContactPoint",
				"contactType": "customer service",
				"email": "contact@pritchard-solutions.com"
			},
			"sameAs": [],
			"service": [
				{
					"@type": "Service",
					"name": "Cybersecurity Solutions",
					"description": "Protect your business from cyber threats with expert security services"
				},
				{
					"@type": "Service",
					"name": "System Automation",
					"description": "Boost efficiency with custom automation solutions"
				},
				{
					"@type": "Service",
					"name": "Cloud & Data Services",
					"description": "Leverage the power of the cloud with migration and management services"
				}
			]
		}
	</script>

	<main>
		<!-- Hero Section -->
		<HeroSection>
			<div id="home" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
					<div class="text-center lg:text-left">
						<h1 class="text-4xl lg:text-6xl font-bold mb-6 text-gray-900 dark:text-gray-100">
							Your Trusted Partner in
							<span class="bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">
								IT & Cybersecurity
							</span>
						</h1>
						<p class="text-xl lg:text-2xl text-gray-600 dark:text-gray-300 mb-8 max-w-2xl">
							We provide innovative IT solutions to help your business thrive in the digital age. From robust cybersecurity to scalable cloud infrastructure, we've got you covered.
						</p>
						<div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
							<a href="/contact" class="px-8 py-4 bg-blue-600 text-white text-lg rounded-lg hover:bg-blue-700 transition-colors shadow-lg hover:shadow-xl">
								Get a Free Quote
							</a>
							<a href="/services" class="px-8 py-4 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 text-lg rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors shadow-lg hover:shadow-xl border border-gray-200 dark:border-gray-700">
								Learn More
							</a>
						</div>
					</div>
					<div class="hidden lg:block relative">
						<!-- Floating Cards Visual -->
						<div class="relative w-full h-96">
							<div class="absolute top-4 left-8 bg-white dark:bg-gray-800 rounded-xl shadow-lg p-6 transform rotate-3 hover:rotate-0 transition-transform duration-300">
								<i class="fas fa-shield-alt text-3xl text-blue-600 dark:text-blue-400 mb-2"></i>
								<div class="text-sm font-semibold text-gray-900 dark:text-gray-100">Security</div>
							</div>
							<div class="absolute top-16 right-12 bg-white dark:bg-gray-800 rounded-xl shadow-lg p-6 transform -rotate-2 hover:rotate-0 transition-transform duration-300">
								<i class="fas fa-cloud text-3xl text-purple-600 dark:text-purple-400 mb-2"></i>
								<div class="text-sm font-semibold text-gray-900 dark:text-gray-100">Cloud</div>
							</div>
							<div class="absolute top-32 left-16 bg-white dark:bg-gray-800 rounded-xl shadow-lg p-6 transform rotate-1 hover:rotate-0 transition-transform duration-300">
								<i class="fas fa-cogs text-3xl text-green-600 dark:text-green-400 mb-2"></i>
								<div class="text-sm font-semibold text-gray-900 dark:text-gray-100">Automation</div>
							</div>
							<div class="absolute bottom-16 right-8 bg-white dark:bg-gray-800 rounded-xl shadow-lg p-6 transform -rotate-1 hover:rotate-0 transition-transform duration-300">
								<i class="fas fa-network-wired text-3xl text-red-600 dark:text-red-400 mb-2"></i>
								<div class="text-sm font-semibold text-gray-900 dark:text-gray-100">Network</div>
							</div>
							<div class="absolute bottom-4 left-4 bg-white dark:bg-gray-800 rounded-xl shadow-lg p-6 transform rotate-2 hover:rotate-0 transition-transform duration-300">
								<i class="fas fa-laptop-code text-3xl text-indigo-600 dark:text-indigo-400 mb-2"></i>
								<div class="text-sm font-semibold text-gray-900 dark:text-gray-100">Development</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</HeroSection>

		<!-- Services Overview -->
		<section id="services" class="py-16 lg:py-24">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-12">
					<h2 class="text-3xl lg:text-4xl font-bold mb-4 text-gray-900 dark:text-gray-100">
						Our Core Services
					</h2>
					<p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
						We offer a comprehensive range of IT services to meet the unique needs of your business.
					</p>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8 hover:shadow-xl transition-shadow">
						<div class="w-12 h-12 bg-blue-100 dark:bg-blue-900 rounded-lg flex items-center justify-center mb-4">
							<i class="fas fa-shield-alt text-2xl text-blue-600 dark:text-blue-400"></i>
						</div>
						<h3 class="text-xl font-semibold mb-3 text-gray-900 dark:text-gray-100">Cybersecurity Solutions</h3>
						<p class="text-gray-600 dark:text-gray-300">
							Protect your business from cyber threats with our expert security services, including penetration testing, vulnerability assessments, and 24/7 monitoring.
						</p>
					</div>
					<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8 hover:shadow-xl transition-shadow">
						<div class="w-12 h-12 bg-green-100 dark:bg-green-900 rounded-lg flex items-center justify-center mb-4">
							<i class="fas fa-cogs text-2xl text-green-600 dark:text-green-400"></i>
						</div>
						<h3 class="text-xl font-semibold mb-3 text-gray-900 dark:text-gray-100">System Automation</h3>
						<p class="text-gray-600 dark:text-gray-300">
							Boost efficiency and reduce manual errors with our custom automation solutions. We streamline your workflows so you can focus on what matters most.
						</p>
					</div>
					<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8 hover:shadow-xl transition-shadow">
						<div class="w-12 h-12 bg-purple-100 dark:bg-purple-900 rounded-lg flex items-center justify-center mb-4">
							<i class="fas fa-cloud text-2xl text-purple-600 dark:text-purple-400"></i>
						</div>
						<h3 class="text-xl font-semibold mb-3 text-gray-900 dark:text-gray-100">Cloud & Data Services</h3>
						<p class="text-gray-600 dark:text-gray-300">
							Leverage the power of the cloud with our migration, management, and data security services. We ensure your data is safe, accessible, and optimized for performance.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Next Steps Section -->
		<section class="py-16 lg:py-24 bg-gray-50 dark:bg-gray-900">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-12">
					<h2 class="text-3xl lg:text-4xl font-bold mb-4 text-gray-900 dark:text-gray-100">
						Ready to Get Started?
					</h2>
					<p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
						Follow these simple steps to transform your business with our IT solutions.
					</p>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					<div class="text-center">
						<div class="w-20 h-20 bg-blue-600 text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">
							1
						</div>
						<h3 class="text-xl font-semibold mb-3 text-gray-900 dark:text-gray-100">Explore Our Services</h3>
						<p class="text-gray-600 dark:text-gray-300 mb-4">
							Discover how our cybersecurity, automation, and cloud solutions can benefit your business.
						</p>
						<a href="/services" class="px-6 py-3 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors shadow border border-gray-200 dark:border-gray-700">
							View Services
						</a>
					</div>
					<div class="text-center">
						<div class="w-20 h-20 bg-purple-600 text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">
							2
						</div>
						<h3 class="text-xl font-semibold mb-3 text-gray-900 dark:text-gray-100">Learn About Our Team</h3>
						<p class="text-gray-600 dark:text-gray-300 mb-4">
							Meet our expert team of IT professionals who will help you achieve your goals.
						</p>
						<a href="/about" class="px-6 py-3 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors shadow border border-gray-200 dark:border-gray-700">
							Meet Team
						</a>
					</div>
					<div class="text-center">
						<div class="w-20 h-20 bg-green-600 text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">
							3
						</div>
						<h3 class="text-xl font-semibold mb-3 text-gray-900 dark:text-gray-100">Get In Touch</h3>
						<p class="text-gray-600 dark:text-gray-300 mb-4">
							Contact us for a free consultation and let's discuss your specific needs.
						</p>
						<a href="/contact" class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors shadow">
							Contact Us
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- CTA Section -->
		<section class="py-16 lg:py-24">
			<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
				<h2 class="text-3xl lg:text-4xl font-bold mb-4 text-gray-900 dark:text-gray-100">
					Ready to Elevate Your Business?
				</h2>
				<p class="text-lg text-gray-600 dark:text-gray-300 mb-8">
					Let us help you achieve your goals with our expert IT solutions.
				</p>
				<a href="/contact" class="px-8 py-4 bg-blue-600 text-white text-lg rounded-lg hover:bg-blue-700 transition-colors shadow-lg hover:shadow-xl">
					Contact Us Today
				</a>
			</div>
		</section>

		<!-- About Section -->
		<section id="about" class="py-16 lg:py-24 bg-gray-50 dark:bg-gray-900">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-12">
					<h2 class="text-3xl lg:text-4xl font-bold mb-4 text-gray-900 dark:text-gray-100">
						Who We Are
					</h2>
					<p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
						We are a team of passionate IT professionals dedicated to helping businesses succeed.
					</p>
				</div>
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
					<div>
						<h3 class="text-2xl font-semibold mb-4 text-gray-900 dark:text-gray-100">Our Mission</h3>
						<p class="text-gray-600 dark:text-gray-300 mb-6">
							To provide our clients with the highest quality IT services and support, enabling them to achieve their business objectives. We are committed to building long-term relationships based on trust, integrity, and mutual respect.
						</p>
						<h3 class="text-2xl font-semibold mb-4 text-gray-900 dark:text-gray-100">Our Vision</h3>
						<p class="text-gray-600 dark:text-gray-300">
							To be the leading provider of IT solutions for small and medium-sized businesses in the region, known for our expertise, reliability, and exceptional customer service.
						</p>
					</div>
					<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8">
						<h4 class="text-xl font-semibold mb-6 text-gray-900 dark:text-gray-100">Meet Our Team</h4>
						<div class="space-y-6">
							<div class="flex items-center space-x-4">
								<picture>
									<source srcset="./assets/Alex.webp" type="image/webp" />
									<img src="./assets/Alex.webp" alt="Alexander Walker" class="w-16 h-16 rounded-full object-cover" />
								</picture>
								<div>
									<h5 class="font-semibold text-gray-900 dark:text-gray-100">Alexander Walker</h5>
									<p class="text-gray-600 dark:text-gray-300">Co-Founder & CEO</p>
								</div>
							</div>
							<div class="flex items-center space-x-4">
								<picture>
									<source srcset="./assets/josh.webp" type="image/webp" />
									<img src="./assets/josh.webp" alt="Joshua Sack" class="w-16 h-16 rounded-full object-cover" />
								</picture>
								<div>
									<h5 class="font-semibold text-gray-900 dark:text-gray-100">Joshua Sack</h5>
									<p class="text-gray-600 dark:text-gray-300">Co-Founder & CTO</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>

	<!-- Footer -->
	<footer class="border-t border-gray-200 dark:border-gray-800 py-12">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 md:grid-cols-4 gap-8">
				<div class="md:col-span-2">
					<div class="flex items-center space-x-2 mb-4">
						<picture>
							<source srcset="./assets/logo.webp" type="image/webp" />
							<img src="./assets/logo.webp" alt="Pritchard Solutions Logo" class="h-8 w-8" />
						</picture>
						<h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Pritchard Specialised Solutions</h3>
					</div>
					<p class="text-gray-600 dark:text-gray-300 max-w-md">
						Your trusted partner in IT and cybersecurity.
					</p>
				</div>
				<div>
					<h4 class="font-semibold mb-4 text-gray-900 dark:text-gray-100">Services</h4>
					<div class="space-y-2">
						<a href="/services" class="block text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-gray-100 transition-colors">Cybersecurity</a>
						<a href="/services" class="block text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-gray-100 transition-colors">Automation</a>
						<a href="/services" class="block text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-gray-100 transition-colors">Cloud Solutions</a>
					</div>
				</div>
				<div>
					<h4 class="font-semibold mb-4 text-gray-900 dark:text-gray-100">Company</h4>
					<div class="space-y-2">
						<a href="/about" class="block text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-gray-100 transition-colors">About Us</a>
						<a href="/contact" class="block text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-gray-100 transition-colors">Contact</a>
						<a href="/privacy" class="block text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-gray-100 transition-colors">Privacy Policy</a>
					</div>
				</div>
			</div>
			<div class="border-t border-gray-200 dark:border-gray-700 mt-8 pt-8 text-center">
				<p class="text-gray-600 dark:text-gray-300">
					&copy; 2025 Pritchard Specialised Solutions. All rights reserved.
				</p>
			</div>
		</div>
	</footer>
</Layout>