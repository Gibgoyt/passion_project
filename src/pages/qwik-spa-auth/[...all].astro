---
import {
  App
} from 'src/applications_qwik/auth-app/App.tsx'
import 'src/styles/global.css'
---

<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Qwik SPA</title>
  <base href="/qwik/">
  <meta name="theme-color" content="#18181b">
  <meta name="color-scheme" content="dark light">
</head>
<body class="h-full bg-zinc-900"> <!-- Add dark background here -->
<div id="qwik-root" class="h-full">
  <App client:load />
</div>

<!-- Add this script to detect and apply dark mode before hydration -->
<script>
  (function() {
    const isDarkMode = localStorage.getItem('darkMode') === 'true' ||
      (!localStorage.getItem('darkMode') && window.matchMedia('(prefers-color-scheme: dark)').matches);

    if (isDarkMode) {
      document.documentElement.classList.add('dark');
    }
  })();
</script>
</body>
</html>