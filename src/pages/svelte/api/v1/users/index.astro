---
import Layout from '../../../../../layouts/Layout.astro';
import UserTable from '../../../../../components-svelte/api/v1/users/UserTable.svelte';
---

<Layout title="User Management (Svelte + Client Validation)">
  <main class="container mx-auto p-4 max-w-5xl mt-10">
    <div class="mb-8 text-center">
        <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100">User Management Console</h1>
        <p class="mt-2 text-gray-600 dark:text-gray-400">
            Client-side Svelte application with runtime validation using shared TypeScript libraries.
        </p>
    </div>

    <!-- Svelte Component (Client Only) -->
    <UserTable client:only="svelte" />
  </main>
</Layout>
