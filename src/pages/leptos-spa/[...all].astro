---
export const prerender = false;
import 'src/styles/global.css'
---

<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WASM SPA - Leptos</title>

  <meta name="theme-color" content="#18181b">
  <meta name="color-scheme" content="dark light">

  <script is:inline>
    // Prevent flash of wrong theme -Sync with Astro app theme
    const isDarkMode = localStorage.getItem('darkMode') === 'true' ||
      (!localStorage.getItem('darkMode') && window.matchMedia('(prefers-color-scheme: dark)').matches);

    if (isDarkMode) {
      document.documentElement.classList.add('dark');
    }
  </script>
</head>
<body class="h-full">
  <div id="wasm-root" class="w-full h-full"></div>

  <script type="module">
    import init, { mount_app } from '/wasm/leptos/main_app/wasm_app.js';

    async function loadWasmApp() {
      try {
        // Initialize the WASM module
        await init('/wasm/leptos/main_app/wasm_app_bg.wasm');

        // Mount the Leptos app to #wasm-root
        mount_app();

        console.log('✅ Leptos WASM app loaded successfully!');
      } catch (err) {
        console.error('❌ Failed to load Leptos WASM app:', err);

        // Show error to user
        const root = document.getElementById('wasm-root');
        if (root) {
          root.innerHTML = `
            <div class="p-8 text-center">
              <h1 class="text-3xl font-bold text-red-400 mb-4">Failed to Load Leptos WASM App</h1>
              <p class="text-zinc-400 mb-4">Please ensure the WASM module is built:</p>
              <code class="bg-zinc-800 px-4 py-2 rounded">cd src/applications_leptos/main_app && ./build.sh</code>
              <p class="text-zinc-500 mt-4 text-sm">${err.message}</p>
            </div>
          `;
        }
      }
    }

    loadWasmApp();
  </script>
</body>
</html>
