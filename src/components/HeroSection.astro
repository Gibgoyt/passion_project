---
// Simple wrapper component that only provides the hero background image
// Usage: Wrap existing hero section content with <HeroSection>...</HeroSection>
---

<section class="relative overflow-hidden">
	<div class="absolute inset-0 -z-10">
		<img
			src="/hero_image_2.webp"
			alt=""
			class="w-full h-full object-cover opacity-50 dark:opacity-70"
		/>
		<div class="absolute inset-0 bg-gradient-to-br from-blue-600/40 to-purple-600/40 dark:from-gray-900/70 dark:to-gray-800/70"></div>
	</div>
	<slot />
</section>
